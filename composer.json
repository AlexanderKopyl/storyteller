{
    "name": "storyteller/storyteller",
    "description": "Interactive choice-driven story platform",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.5",
        "doctrine/doctrine-bundle": "^2.17",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.5",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/error-handler": "7.4.*",
        "symfony/event-dispatcher": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/finder": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/http-foundation": "7.4.*",
        "symfony/monolog-bridge": "7.4.*",
        "symfony/monolog-bundle": "^4.1",
        "symfony/options-resolver": "7.4.*",
        "symfony/process": "7.4.*",
        "symfony/routing": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/serializer": "7.4.*",
        "symfony/stopwatch": "7.4.*",
        "symfony/string": "7.4.*",
        "symfony/uid": "7.4.*",
        "symfony/validator": "7.4.*",
        "symfony/var-dumper": "7.4.*",
        "symfony/var-exporter": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "deptrac/deptrac": "^4.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "Storyteller\\": "src/",
            "Storyteller\\Shared\\": "src/Shared/",
            "Storyteller\\Engine\\": "src/Engine/",
            "Storyteller\\Content\\": "src/Content/",
            "Storyteller\\Play\\": "src/Play/",
            "Storyteller\\Api\\": "src/Api/",
            "Storyteller\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Storyteller\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --memory-limit=1G",
        "cs-fix": "vendor/bin/php-cs-fixer fix",
        "deptrac": "vendor/bin/deptrac analyse --config-file=deptrac.yaml",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "qa": [
            "@cs-check",
            "@phpstan",
            "@deptrac",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite",
        "phpstan": "Static analysis at level 8",
        "cs-fix": "Apply PSR-12 formatting with php-cs-fixer",
        "deptrac": "Check the bounded-context dependency rule",
        "cs-check": "Verify PSR-12 formatting without writing files",
        "qa": "Run all four quality gates in order: cs-check, phpstan, deptrac, test"
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        },
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
