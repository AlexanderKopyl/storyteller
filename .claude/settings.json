{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "additionalDirectories": [
      "/private/tmp/claude-501"
    ],
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Edit",
      "Write",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(wc *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(tree *)",
      "Bash(which *)",
      "Bash(diff *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(awk *)",
      "Bash(jq *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(uname *)",
      "Bash(composer *)",
      "Bash(php *)",
      "Bash(vendor/bin/*)",
      "Bash(bin/console *)",
      "Bash(bin/magento *)",
      "Bash(php bin/console *)",
      "Bash(make *)",
      "Bash(docker compose *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore *)",
      "Bash(git rev-list *)",
      "Bash(git blame *)",
      "Bash(git shortlog *)",
      "Bash(docker info)",
      "Bash(git rev-parse*)",
      "Bash(git branch*)",
      "Bash(git init*)",
      "Bash(git add*)",
      "Bash(git commit*)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(rm -r *)",
      "Bash(git push --force*)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)",
      "Bash(git rebase*)",
      "Bash(git filter-branch*)",
      "Bash(php bin/console doctrine:database:drop*)",
      "Bash(php bin/console doctrine:schema:drop*)",
      "Bash(bin/console doctrine:database:drop*)",
      "Bash(bin/console doctrine:schema:drop*)",
      "Read(.env*)",
      "Read(./.env*)",
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/id_rsa*)",
      "Read(**/credentials*)",
      "Edit(**/.env*)",
      "Write(**/.env*)",
      "Bash(cat .env*)",
      "Bash(cat ./.env*)",
      "Bash(head .env*)",
      "Bash(tail .env*)",
      "Bash(grep * .env*)",
      "Bash(cp .env*)",
      "Bash(mv .env*)",
      "Bash(php -r *)",
      "Bash(php -a*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-paths.sh",
            "timeout": 15,
            "statusMessage": "Checking protected paths"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/freeze-tests.sh",
            "timeout": 15,
            "statusMessage": "Checking test freeze"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PROJECT_DIR}/.claude/hooks/format-php.sh",
            "timeout": 60,
            "statusMessage": "php-cs-fixer"
          }
        ]
      }
    ]
  }
}
