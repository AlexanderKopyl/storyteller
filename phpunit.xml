<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         cacheDirectory=".phpunit.cache"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         failOnSkipped="true"
         beStrictAboutOutputDuringTests="true"
         requireCoverageMetadata="false">
    <testsuites>
        <testsuite name="unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <coverage ignoreDeprecatedCodeUnits="true" disableCodeCoverageIgnore="true"/>

    <source>
        <include>
            <directory>src</directory>
        </include>
    </source>

    <php>
        <ini name="display_errors" value="1"/>
        <ini name="error_reporting" value="-1"/>
        <!-- <env> (not just <server>) is deliberate: KernelTestCase reads $_ENV['APP_ENV']
             before $_SERVER['APP_ENV'], so only these two lines make the suite immune to
             an ambient APP_ENV - an exported shell var, a CI runner, a container env.
             They are hardening in their own right and are kept now that `env_file: .env`
             is gone from compose.yaml; they are not what makes the container work. -->
        <env name="APP_ENV" value="test" force="true"/>
        <env name="APP_DEBUG" value="1" force="true"/>
        <server name="APP_ENV" value="test" force="true"/>
        <server name="APP_DEBUG" value="1" force="true"/>
        <server name="SHELL_VERBOSITY" value="-1"/>
        <server name="KERNEL_CLASS" value="Storyteller\Kernel"/>
    </php>
</phpunit>
